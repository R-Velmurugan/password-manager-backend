input InputPassword{
    domain : String!
    url : String!
    username : String!
    email : String!
    password : String!
    uname : String!
    masterPassword : String!
    notes : String
}

type Mutation{
    insertPassword(passwordInput : InputPassword!) : Password
    deletePassword(uuid : String!) : Boolean
    updatePassword(uuid : String! , password : String!) : Boolean
    restorePassword(uuid : String!) : Boolean
}